{
  "name": "the-crimson-arc",
  "version": "0.2.3",
  "private": true,
  "description": "호를 그리는 크림슨 베젤의 가상 기계식 다이버 워치 The Crimson Arc를 소개하는 Canvas 기반 스크롤·마우스 반응형 브랜드 쇼케이스",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/app/**"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-storybook": "storybook build -o dist/storybook --quiet",
    "build:all": "pnpm build && pnpm build-storybook",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "screenshots": "node scripts/screenshots.mjs",
    "sequence": "node scripts/render-sequence.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lenis": "1.3.27",
    "lil-gui": "0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@react-three/test-renderer": "9.1.1",
    "@size-limit/file": "14.3.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/omggif": "1.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "omggif": "1.0.10",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "size-limit": "14.3.0",
    "steiger": "0.10.0",
    "storybook": "10.6.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
